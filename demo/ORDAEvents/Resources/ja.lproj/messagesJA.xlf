<?xml version="1.0" encoding="UTF-8"?>
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
	<file datatype="plaintext" original="messagesJA.xlf" source-language="en" target-language="ja">
		<body>
			<trans-unit id="Order_SelectClient" resname="Order_SelectClient">
				<source>Select client</source>
				<target>顧客を選択</target>
			</trans-unit>
			<trans-unit id="Order_SelectPayment" resname="Order_SelectPayment">
				<source>Select method</source>
				<target>支払方法を選択</target>
			</trans-unit>
			<trans-unit id="Order_SelectStatus" resname="Order_SelectStatus">
				<source>Select Status</source>
				<target>ステータスを選択</target>
			</trans-unit>
			<trans-unit id="Status_InProgress" resname="Status_InProgress">
				<source>In progress</source>
				<target>処理中</target>
			</trans-unit>
			<trans-unit id="Status_Validate" resname="Status_Validate">
				<source>Validate</source>
				<target>確定済み</target>
			</trans-unit>
			<trans-unit id="Status_Delivered" resname="Status_Delivered">
				<source>Delivered</source>
				<target>配送済み</target>
			</trans-unit>
			<trans-unit id="Payment_PayPal" resname="Payment_PayPal">
				<source>PayPal</source>
				<target>PayPal</target>
			</trans-unit>
			<trans-unit id="Payment_CreditCard" resname="Payment_CreditCard">
				<source>credit card</source>
				<target>クレジットカード</target>
			</trans-unit>
			<trans-unit id="Payment_BankTransfer" resname="Payment_BankTransfer">
				<source>bank transfer</source>
				<target>銀行振込</target>
			</trans-unit>
			<trans-unit id="Format_Currency" resname="Format_Currency">
				<source>$^^^,^^0;-$^^^,^^0</source>
				<target>¥#,###,###,##0;-¥#,###,###,##0</target>
			</trans-unit>
			<trans-unit id="AlertEnterClient" resname="AlertEnterClient">
				<source>please enter a client</source>
				<target>顧客を選択してください。</target>
			</trans-unit>
			<trans-unit id="AlertSelectOrder" resname="AlertSelectOrder">
				<source>Please select one order</source>
				<target>注文を1件選択してください。</target>
			</trans-unit>
			<trans-unit id="Stock_Insufficient" resname="Stock_Insufficient">
				<source>Insufficient stock</source>
				<target>在庫不足</target>
			</trans-unit>
			<trans-unit id="Stock_InsufficientInfo" resname="Stock_InsufficientInfo">
				<source>The product {name} is lower({qty})</source>
				<target>商品「{name}」の在庫が注文数（{qty}）より少なくなっています</target>
			</trans-unit>
			<trans-unit id="Stock_OutOfStock" resname="Stock_OutOfStock">
				<source>🔴 OUT OF STOCK!</source>
				<target>🔴 在庫切れです！</target>
			</trans-unit>
			<trans-unit id="Stock_Low" resname="Stock_Low">
				<source>⚠️ LOW STOCK</source>
				<target>⚠️ 在庫が少なくなっています</target>
			</trans-unit>
			<trans-unit id="Stock_Product" resname="Stock_Product">
				<source>Product: {name}</source>
				<target>商品：{name}</target>
			</trans-unit>
			<trans-unit id="Stock_Zero" resname="Stock_Zero">
				<source>Stock: 0</source>
				<target>在庫数：0</target>
			</trans-unit>
			<trans-unit id="Stock_Current" resname="Stock_Current">
				<source>Current stock: {n}</source>
				<target>現在の在庫数：{n}</target>
			</trans-unit>
			<trans-unit id="Stock_Minimum" resname="Stock_Minimum">
				<source>Minimum stock: {n}</source>
				<target>最小在庫数：{n}</target>
			</trans-unit>
			<trans-unit id="Stock_Negative" resname="Stock_Negative">
				<source>The stock can not be negative</source>
				<target>在庫数を負の値にすることはできません</target>
			</trans-unit>
			<trans-unit id="Order_PriceZero" resname="Order_PriceZero">
				<source>⚠️ WARNING: Order {number} validated/delivered but price is 0 €</source>
				<target>⚠️ 警告：注文{number}は確定済みまたは配送済みですが、金額が0です</target>
			</trans-unit>
			<trans-unit id="AlertSaveError" resname="AlertSaveError">
				<source>{message} :{info}</source>
				<target>{message}：{info}</target>
			</trans-unit>
		</body>
	</file>
</xliff>
